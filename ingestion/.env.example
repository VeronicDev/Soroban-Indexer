# Soroban RPC endpoint (testnet example)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Comma-separated list of contract IDs to index.
# Default: the Stellar Asset Contract for XLM on testnet — actively emitting events.
CONTRACT_IDS=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# How often to poll RPC for new events, in milliseconds
POLL_INTERVAL_MS=5000

# Retry backoff for retryable RPC failures (rate limit, timeout, 5xx).
# Delays double per attempt with jitter, capped at RETRY_MAX_MS.
RETRY_BASE_MS=1000
RETRY_MAX_MS=300000

# Postgres connection string (overridden by docker-compose in local dev)
DATABASE_URL=postgres://indexer:indexer@localhost:5432/soroban_indexer
