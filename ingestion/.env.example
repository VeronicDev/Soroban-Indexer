# Soroban RPC endpoint (testnet example)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Comma-separated list of contract IDs to index
CONTRACT_IDS=CBQHNAXSI55GX2GN6D67GK7BHVPSLJUGZQEU7WJ5LKR5PNUCGLIMAO4E

# How often to poll RPC for new events, in milliseconds
POLL_INTERVAL_MS=5000

# Postgres connection string (overridden by docker-compose in local dev)
DATABASE_URL=postgres://indexer:indexer@localhost:5432/soroban_indexer
